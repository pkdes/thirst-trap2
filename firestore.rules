rules_version = '2';

// Thirst Trap security rules.
//
// The previous rules were `allow read, write: if request.auth != null`, which let
// any signed-in Google account read and write every household's data. These scope
// every collection to the caller's own household instead.
//
// Household membership is the unit of authorization: a user doc holds one
// householdId, and every plant / log / family document carries the same field.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myHousehold() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myUserDoc().householdId
        : null;
    }

    // A document belongs to me if its householdId matches mine.
    function mine(data) {
      return signedIn() && data.householdId != null && data.householdId == myHousehold();
    }

    // Both the existing document and the incoming one must be in my household, so
    // a write can't move a record into or out of someone else's data.
    function mineForWrite() {
      return mine(request.resource.data)
        && (resource == null || mine(resource.data));
    }

    // --- users ---------------------------------------------------------------
    // You can only ever see or touch your own profile.
    //
    // householdId is the key to every other collection, so it can only point at a
    // household that already lists you as a member. Without this, anyone could
    // write a guessed invite code here and read that household without joining
    // (and without counting against the 2-member cap).
    function householdLists(householdId, uid) {
      return exists(/databases/$(database)/documents/households/$(householdId))
        && uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function userKeys() {
      return ['householdId', 'displayName', 'email', 'photoURL', 'notifications'];
    }

    function validUserFields() {
      let d = request.resource.data;
      return (!('householdId' in d) || householdLists(d.householdId, request.auth.uid))
        && (!('notifications' in d) || d.notifications is map);
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(userKeys())
        && validUserFields();
      // Checks changed keys only, so a legacy field on an existing profile
      // doesn't lock its owner out of saving notification settings.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys())
        && validUserFields();
    }

    // --- households ----------------------------------------------------------
    // The 6-character doc ID is the invite code, so knowing it is the credential:
    // any signed-in user may `get` one by ID in order to join. Listing is denied,
    // so codes can't be enumerated. Only members can change one.
    match /households/{householdId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      // Joining adds yourself; membership is capped at 2.
      allow update: if signedIn()
        && (
          request.auth.uid in resource.data.members
          || (
            // Joining: add yourself and nothing else — no removing the owner,
            // no renaming the household.
            request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && resource.data.members.size() < 2
            && request.resource.data.members.size() <= 2
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          )
        );
      allow delete: if false;
    }

    // --- household-scoped collections ----------------------------------------
    match /plants/{plantId} {
      allow read: if mine(resource.data);
      allow create, update: if mineForWrite();
      allow delete: if mine(resource.data);
    }

    // A care log can be corrected (its date, who edited it) but never re-pointed
    // at another plant or household.
    function logEditOnly(dateField) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([dateField, 'editedBy', 'editedAt'])
        && request.resource.data[dateField] is timestamp;
    }

    match /wateringLogs/{logId} {
      allow read: if mine(resource.data);
      allow create: if mineForWrite();
      allow update: if mineForWrite() && logEditOnly('wateredAt');
      allow delete: if mine(resource.data);
    }

    match /checkLogs/{logId} {
      allow read: if mine(resource.data);
      allow create: if mineForWrite();
      allow update: if mineForWrite() && logEditOnly('checkedAt');
      allow delete: if mine(resource.data);
    }

    match /fertilizerLogs/{logId} {
      allow read: if mine(resource.data);
      allow create: if mineForWrite();
      allow update: if mineForWrite() && logEditOnly('fertilizedAt');
      allow delete: if mine(resource.data);
    }

    match /healthLogs/{logId} {
      allow read: if mine(resource.data);
      allow create, update: if mineForWrite();
      allow delete: if mine(resource.data);
    }

    match /plantFamilies/{familyId} {
      allow read: if mine(resource.data);
      allow create, update: if mineForWrite();
      allow delete: if mine(resource.data);
    }

    match /familyEvents/{eventId} {
      allow read: if mine(resource.data);
      allow create, update: if mineForWrite();
      allow delete: if mine(resource.data);
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
